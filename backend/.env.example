# OpenRouter API key for AI-powered status updates
# Sign up at https://openrouter.ai/keys — the free tier includes google/gemma-2-9b-it:free and other models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub personal access token (optional — increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Server port (default: 8080)
PORT=8080

# PostgreSQL connection string (Neon)
# IMPORTANT: Remove any &channel_binding=require parameter — Go's lib/pq driver doesn't support it
# For Lambda/concurrency, append ?pgbouncer=true (or use Neon's pooled host) to avoid pool exhaustion
DATABASE_URL=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Secret key for admin contact page access
CONTACT_SECRET=change-this-to-a-random-secret

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-api-gateway-url/prod/api/auth/google/callback

# JWT secret for signing tokens
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# Frontend URL (for OAuth redirect)
FRONTEND_URL=http://localhost:5173

# Analytics dashboard secret (falls back to CONTACT_SECRET if unset — set explicitly in prod)
ANALYTICS_SECRET=change-this-to-a-random-secret
# Set true to run DB migrations at boot (prefer a pre-deploy job instead)
RUN_MIGRATIONS=false
# AWS region/bucket for uploads (defaults: ap-south-1 / portfolio-uploads-sentinel)
AWS_REGION=ap-south-1
S3_BUCKET=portfolio-uploads-sentinel
